# Copy to .env (never commit .env)

DATABASE_URL=postgresql://dex:dex@localhost:5432/dex_sourcing?schema=public
REDIS_URL=redis://localhost:6379

ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_PATH=.artifacts

AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TAVILY_API_KEY=

# Approx number of supplier rows returned after ranking
RESULT_LIMIT=10

# Auth / email verification (production)
# AUTH_SECRET=long-random-string
# APP_BASE_URL=https://your-app.up.railway.app
# RESEND_API_KEY=re_...
# EMAIL_FROM="DEX Sourcing <noreply@your-verified-domain.com>"
#
# Only @dex.com can request or complete verification (enforced in code).
# Optional extra restriction to specific DEX users:
# DEX_ALLOWED_EMAILS=alice@dex.com,bob@dex.com

# Optional machine/API access header (x-api-key). Not used for human login.
# DEX_API_KEY=optional-machine-key

# WORKER_QUEUES=jobs-resolve,jobs-discover,jobs-extract,jobs-normalize,jobs-enrich,jobs-knowledge
