# Copy to .env (never commit .env)

DATABASE_URL=postgresql://dex:dex@localhost:5432/dex_sourcing?schema=public
REDIS_URL=redis://localhost:6379

ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_PATH=.artifacts

AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TAVILY_API_KEY=

# Approx number of supplier rows returned after ranking
RESULT_LIMIT=10

# Production sign-in: only @dex.com emails are accepted (Gmail/etc. blocked in code).
# AUTH_SECRET is required to sign login cookies.
# AUTH_SECRET=long-random-string
#
# Optional: further restrict to specific DEX people (otherwise any @dex.com works)
# DEX_ALLOWED_EMAILS=alice@dex.com,bob@dex.com

# Optional machine/API access header (x-api-key). Not used for the human login screen.
# DEX_API_KEY=optional-machine-key

# WORKER_QUEUES=jobs-resolve,jobs-discover,jobs-extract,jobs-normalize,jobs-enrich,jobs-knowledge
